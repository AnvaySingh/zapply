# zapply — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is gitignored; never commit real keys.

# --- Which provider drives the LLM seam --------------------------------------
# One of: gemini (free, default) | anthropic | openai (any OpenAI-compatible endpoint).
LLM_PROVIDER=gemini

# --- Google Gemini (free tier — the default) ---------------------------------
# Get a free key (no credit card) at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Free-tier models: gemini-3.6-flash (default), gemini-flash-latest
GEMINI_MODEL=gemini-3.6-flash
# Gemini's OpenAI-compatible endpoint (leave as-is):
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Anthropic (Claude) — set LLM_PROVIDER=anthropic to use ------------------
# Key + credit at https://console.anthropic.com/settings/keys  (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Generic OpenAI-compatible (OpenAI / Groq / Ollama / OpenRouter) ---------
# Set LLM_PROVIDER=openai and point these at any compatible endpoint.
#   Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1   (free key at console.groq.com)
#   Ollama: OPENAI_BASE_URL=http://localhost:11434/v1        (local, no key needed)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Langfuse (observability / tracing) --------------------------------------
# Free cloud tier: https://cloud.langfuse.com  (create a project, then Settings → API Keys)
# If these are left blank, the app still runs — tracing simply becomes a no-op.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
